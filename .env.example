# Optional public browser configuration. No configuration is needed to run.
# VITE_* values are bundled into client JavaScript; never put secrets here.
# Leave empty to disable analytics. Only loaded in production.
VITE_GA_MEASUREMENT_ID=

# Advertising script loading is currently disabled in src/utils/adsense.ts.
# Publisher/slot identifiers alone do not enable ads.
VITE_ADSENSE_CLIENT_ID=
VITE_ADSENSE_SLOT_HOME=
VITE_ADSENSE_SLOT_DASHBOARD=
